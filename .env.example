# BASE_URL은 API 주소에서 항상 똑같이 붙는 앞부분
# API 요청 주소 1. BASE_URL과 경로(endpoint)로 나뉨
# 요청을 보낼 백엔드 서버 주소 저장
VITE_API_BASE_URL=https://fastapi-practice-jwse.onrender.com

# EmailJS feedback: public identifiers only; never add a private key or email password.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
